<view class="shell">
  <view class="brand"><view class="brand-mark">叶</view><view><view class="brand-title">交易伙伴</view><view class="muted">让每一次判断，都有迹可循</view></view><text wx:if="{{logged}}" class="logout" bindtap="logout">退出</text></view>
  <view wx:if="{{!logged}}" class="login card"><view class="eyebrow">你的私人交易空间</view><view class="heading">慢一点判断，<view>清楚地行动。</view></view><text class="muted">对话、积累与复盘，都在这里。</text><input class="input" password placeholder="输入访问密码" value="{{password}}" data-field="password" bindinput="input"/><button class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="login">进入我的空间</button><view class="muted note">私人空间 · joakly.site</view></view>
  <block wx:if="{{logged}}">
    <view class="tabs"><view class="{{tab==='chat'?'selected':''}}" data-tab="chat" bindtap="switchTab">对话</view><view class="{{tab==='library'?'selected':''}}" data-tab="library" bindtap="switchTab">知识库</view><view class="{{tab==='system'?'selected':''}}" data-tab="system" bindtap="switchTab">交易体系</view></view>
    <block wx:if="{{tab==='chat'}}">
      <view class="toolbar"><picker range="{{models}}" range-key="label" value="{{modelIndex}}" disabled="{{busy}}" bindchange="changeModel"><text>{{models[modelIndex].label || '选择模型'}} ▾</text></picker><text bindtap="history">历史</text><text bindtap="newChat">新对话</text></view>
      <scroll-view class="conversation" scroll-y scroll-into-view="{{scrollId}}" scroll-with-animation>
        <view wx:if="{{!messages.length}}" class="welcome"><view class="eyebrow">随时记下，也随时回看</view><view class="heading">今天想聊些什么？</view><view class="muted">说说你的观察，整理一段学习笔记，<view>或一起检查下一步的交易计划。</view></view></view>
        <view wx:for="{{messages}}" wx:key="index" id="message-{{index}}" class="message {{item.role}}"><text class="message-label">{{item.role==='user'?'我':'交易伙伴'}}</text><view class="message-text"><text selectable>{{item.text || '正在整理思路…'}}</text></view><view wx:for="{{item.attachments}}" wx:for-item="attachment" wx:key="id" class="file-chip">{{attachment.name}}</view></view>
        <view class="muted note" wx:if="{{status}}">{{status}}</view>
      </scroll-view>
      <view class="composer"><view wx:if="{{recording}}" class="voice-panel"><view class="voice-indicator"><view class="voice-dot"/><text>{{voicePhase==='starting'?'准备录音…':voicePhase==='stopping'?'正在结束录音…':'正在聆听'}}</text><text class="voice-clock">{{voiceTime}}</text></view><view class="muted">最长 2 分钟 · 完成后可核对转写文字</view><view class="voice-actions"><button bindtap="cancelVoice">取消</button><button class="primary" bindtap="voice" disabled="{{voicePhase!=='recording'}}">完成录音</button></view></view><view wx:if="{{voicePending}}" class="muted">正在准备麦克风…</view><view wx:if="{{voiceRetry && !uploading}}" class="voice-panel"><text>录音已保留，转写未完成。</text><view class="voice-actions"><button bindtap="discardVoice">放弃录音</button><button class="primary" bindtap="transcribeVoice">重试转写</button></view></view><view wx:if="{{micDenied}}" class="voice-actions"><text class="muted">开启麦克风后即可录音</text><button size="mini" bindtap="openMicSettings">打开设置</button></view><view class="files"><view wx:for="{{attachments}}" wx:key="id" class="file-chip" data-index="{{index}}" bindtap="remove">{{item.name}} ×</view></view><textarea auto-height maxlength="16000" value="{{text}}" data-field="text" bindinput="input" placeholder="输入想法，或添加图片、文件与语音…" disabled="{{busy||recording}}"/><view class="composer-actions"><text bindtap="attach">＋ 附件</text><text bindtap="voice" class="{{recording?'recording':''}}">{{recording?'■ 完成录音':'◉ 语音'}}</text><button class="primary send" loading="{{busy||uploading}}" disabled="{{busy||uploading||recording||voicePending||voiceRetry}}" bindtap="send">发送</button></view><view class="remember"><switch checked="{{remember}}" color="#315e4d" bindchange="remember" disabled="{{busy}}"/><text>允许整理到我的资料</text></view><text wx:if="{{uploading}}" class="muted">正在上传与解析附件…</text></view>
    </block>
    <block wx:if="{{tab==='library'}}"><view class="page-title">知识库<text class="muted">{{total}} 条积累</text></view><view class="search"><input placeholder="搜索原话、认识或交易记录" value="{{query}}" data-field="query" bindinput="input" confirm-type="search" bindconfirm="search"/><text bindtap="search">搜索</text></view><view class="filters"><text class="{{group==='all'?'active':''}}" data-group="all" bindtap="filter">全部</text><text class="{{group==='practice'?'active':''}}" data-group="practice" bindtap="filter">交易实践</text><text class="{{group==='knowledge'?'active':''}}" data-group="knowledge" bindtap="filter">学习认识</text><text class="{{group==='research'?'active':''}}" data-group="research" bindtap="filter">研究资料</text></view><view wx:for="{{records}}" wx:key="id" class="card record" data-id="{{item.id}}" bindtap="openRecord"><view class="eyebrow">{{item.kindLabel}} · {{item.updated_at}}</view><view class="record-title">{{item.title}}</view><view class="excerpt">{{item.summary}}</view><text class="link">查看完整资料 →</text></view><view wx:if="{{!records.length}}" class="empty">还没有匹配的资料，试试其他关键词。</view><button wx:if="{{records.length<total}}" bindtap="more">加载更多</button></block>
    <block wx:if="{{tab==='system'}}"><view class="page-title">交易体系</view><view class="card"><view class="eyebrow">已确认的行动依据</view><view class="record-title">当前生效规则</view><view wx:for="{{rules}}" wx:key="index" class="rule"><text selectable>{{item.text || item}}</text></view><view wx:if="{{!rules.length}}" class="muted">尚未形成已确认规则。候选认识经过你的确认后，才会成为行动纪律。</view></view><view wx:for="{{layers}}" wx:key="key" class="card"><view class="layer-title"><text class="layer-mark">{{item.title}}</text><text>{{item.subtitle}}</text></view><view wx:for="{{item.items}}" wx:for-item="row" wx:key="id" class="layer-row" data-id="{{row.id}}" bindtap="openRecord"><text>{{row.text}}</text><text class="link">›</text></view><text wx:if="{{!item.items.length}}" class="muted">这一层还在积累中</text></view></block>
  </block>
  <view wx:if="{{showPrivacy}}" class="overlay"><view class="detail privacy-sheet"><view class="record-title">使用语音与附件</view><view class="muted">你主动选择的录音、图片和文件会传到个人云端，用于转写与对话。录音转写后由你核对，点击发送才进入对话。</view><text class="link" bindtap="openPrivacy">阅读{{privacyTitle}} →</text><view class="voice-actions"><button bindtap="disagreePrivacy">暂不使用</button><button id="privacy-agree" class="primary" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="agreePrivacy">同意并继续</button></view></view></view><view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{detail}}" class="overlay"><view class="detail"><view class="detail-head"><text>{{detail.title}}</text><text bindtap="closeDetail">关闭</text></view><scroll-view scroll-y class="detail-body"><view wx:for="{{detail.sections}}" wx:key="label" class="detail-section"><view class="eyebrow">{{item.label}}</view><text selectable>{{item.text}}</text></view></scroll-view></view></view>
</view>
