page{background:#f6f7f3;color:#23352e;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx}button{font-size:28rpx}button:after{border:0}.shell{padding:28rpx 32rpx calc(30rpx + env(safe-area-inset-bottom))}.brand{display:flex;align-items:center;gap:20rpx;margin:12rpx 0 36rpx}.brand-mark{background:#315e4d;color:#fff;width:68rpx;height:68rpx;line-height:68rpx;text-align:center;border-radius:24rpx;font-size:30rpx}.brand-title{font-size:34rpx;font-weight:600;letter-spacing:3rpx}.muted{color:#869088;font-size:24rpx;line-height:1.8}.logout{margin-left:auto;color:#869088;font-size:24rpx}.card{background:#fff;border:1rpx solid #e8ece6;border-radius:28rpx;padding:32rpx;margin-bottom:24rpx;box-shadow:0 8rpx 24rpx #23352e04}.login{margin-top:90rpx;padding:44rpx}.eyebrow{color:#819185;font-size:23rpx;margin-bottom:18rpx;letter-spacing:1rpx}.heading{font-size:46rpx;line-height:1.5;font-weight:600;margin:20rpx 0}.input{background:#f5f7f3;padding:28rpx;border-radius:18rpx;margin:40rpx 0 20rpx}.primary{background:#315e4d;color:#fff;border-radius:18rpx}.primary[disabled]{background:#8ca396;color:#fff}.note{margin-top:24rpx;font-size:22rpx}.tabs{display:flex;background:#eaeee7;padding:8rpx;border-radius:20rpx;margin-bottom:24rpx}.tabs>view{flex:1;text-align:center;padding:18rpx 0;color:#78877c}.tabs .selected{background:#fff;color:#315e4d;border-radius:15rpx;box-shadow:0 3rpx 12rpx #23352e08;font-weight:600}.toolbar{display:flex;gap:24rpx;color:#5b7766;font-size:24rpx;padding:0 8rpx 18rpx}.toolbar picker{margin-right:auto}.conversation{height:48vh}.welcome{padding:42rpx 12rpx}.message{margin:24rpx 0;padding:26rpx;background:white;border-radius:22rpx}.message.user{background:#e7eee6;margin-left:48rpx}.message-label{font-size:21rpx;color:#829087}.message-text{white-space:pre-wrap;line-height:1.85;margin-top:10rpx;overflow-wrap:anywhere}.composer{margin-top:24rpx;padding:26rpx;background:white;border:1rpx solid #e1e8dd;border-radius:26rpx}.composer textarea{width:100%;min-height:110rpx;max-height:250rpx;line-height:1.7}.composer-actions{display:flex;align-items:center;gap:28rpx;color:#5a7665;font-size:25rpx}.send{margin-right:0;line-height:2.5;padding:0 28rpx}.files{display:flex;flex-wrap:wrap;gap:10rpx}.file-chip{font-size:22rpx;background:#edf2eb;border-radius:12rpx;padding:12rpx;margin-bottom:12rpx;overflow-wrap:anywhere}.remember{display:flex;align-items:center;font-size:22rpx;color:#869088;margin-top:18rpx}.remember switch{transform:scale(.65);transform-origin:left center;width:80rpx}.recording{color:#af534b}.page-title{font-size:40rpx;font-weight:600;margin:36rpx 0 24rpx;display:flex;align-items:center;justify-content:space-between}.search{display:flex;align-items:center;gap:18rpx;background:#fff;padding:24rpx;border-radius:18rpx}.search input{flex:1}.search text{color:#315e4d}.filters{display:flex;gap:22rpx;font-size:23rpx;padding:26rpx 0;color:#869088}.active{color:#315e4d;font-weight:600}.record-title{font-size:31rpx;font-weight:500;margin-bottom:18rpx}.excerpt{color:#68796d;line-height:1.8;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}.link{color:#50785d;font-size:24rpx;display:block;margin-top:22rpx}.empty{text-align:center;padding:70rpx 0;color:#869088}.layer-title{display:flex;align-items:center;gap:20rpx;font-size:32rpx;margin-bottom:24rpx}.layer-mark{background:#e8efe4;border-radius:16rpx;padding:14rpx 20rpx;color:#557449}.layer-row{padding:22rpx 0;border-top:1rpx solid #eef1eb;display:flex;gap:16rpx;line-height:1.7}.layer-row>text:first-child{flex:1}.layer-row .link{margin-top:0}.rule{padding:16rpx 0;line-height:1.8}.error{background:#f8eee8;color:#9a5b45;border-radius:18rpx;padding:24rpx;margin-top:22rpx;font-size:25rpx;line-height:1.6}.overlay{position:fixed;inset:0;background:#23352e55;display:flex;align-items:flex-end;z-index:10}.detail{background:#fafbf7;border-radius:32rpx 32rpx 0 0;width:100%;padding:32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));