.voice-panel{background:#f0f5ec;border-radius:18rpx;padding:24rpx;margin-bottom:22rpx}.voice-indicator{display:flex;align-items:center;gap:16rpx;margin-bottom:12rpx}.voice-dot{width:14rpx;height:14rpx;border-radius:50%;background:#b85e53;animation:voice-pulse 1.5s ease-in-out infinite}.voice-clock{margin-left:auto;font-variant-numeric:tabular-nums;color:#315e4d}.voice-actions{display:flex;gap:20rpx;align-items:center;margin-top:22rpx}.voice-actions button{flex:1;font-size:25rpx;line-height:2.7}.privacy-sheet{padding-top:44rpx}.privacy-sheet .voice-actions{margin-top:32rpx}@keyframes voice-pulse{50%{opacity:.4}}
